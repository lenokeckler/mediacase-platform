# Nodo coordinador (node-1, el host Windows). Copiar a infra/env/node1.env y ajustar.
# Lo lee scripts/run-coordinator.ps1.
DATABASE_URL=postgres://media:media@localhost:5432/mediacase?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
PORT=8080

# MinIO: ENDPOINT es como lo ve este proceso; PUBLIC_ENDPOINT es como lo ven los OTROS nodos
# (y como se escriben las URLs de resultados). Poner aquí la IP de esta máquina en el WiFi.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=192.168.1.10:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=results
