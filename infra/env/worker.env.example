# Worker en OTRA máquina (VM, laptop de un compañero, la PC del profe).
# El ZIP que sirve GET /download/worker trae este archivo ya lleno; esto es la referencia.
# Solo hace falta saber dónde está el coordinador: el worker abre él la conexión.
WORKER_ID=
WORKER_ROLE=all
WORKER_POOL_SIZE=auto
COORDINATOR_URL=http://192.168.1.10:8080
MINIO_ENDPOINT=192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=192.168.1.10:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=results
